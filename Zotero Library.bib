}

@online{youCharacterizationActiveCancellation2026,
  title = {Characterization and Active Cancellation of Power-Line-Induced Motional-Mode Frequency Noise in a Trapped-Ion System},
  author = {You, Jaehun and Kang, Jiyong and Kim, Kyunghye and Choi, Wonhyeong and Kim, Taehyun},
  date = {2026-02-23},
  eprint = {2602.19588},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  doi = {10.48550/arXiv.2602.19588},
  url = {http://arxiv.org/abs/2602.19588},
  urldate = {2026-03-24},
  abstract = {The stability of motional-mode frequency is essential for realizing high-fidelity quantum gates in trapped-ion quantum computing. While broadband Gaussian noise has been extensively studied and mitigated using pulse shaping techniques, the impact of coherent periodic noise has remained largely unexplored. Here we report a systematic investigation of 60-Hz power-line noise and its effect on the secular frequencies of a single \$\{\}\textasciicircum\{171\}\textbackslash mathrm\{Yb\}\textasciicircum\{+\}\$ ion. Using spin-echo Ramsey spectroscopy, we characterize the amplitude and phase of the resulting secular-frequency modulation and validate this characterization via passive phase correction of the Ramsey sequence. Building on this, we implement active cancellation by injecting a compensation tone into the set-point of a PI controller that stabilizes the trap RF drive amplitude. A phasor-fitting procedure optimizes the amplitude and phase of the compensation signal, enabling near-complete suppression of the 60-Hz component. With active cancellation engaged, the coherence time of a radial motional mode is extended from approximately 10 ms to 35 ms, consistent with the limit set by motional heating. Our results provide both a clear characterization of periodic motional-mode noise and a practical framework for its suppression in trapped-ion quantum computing platforms.},
  pubstate = {prepublished},
  keywords = {Quantum Physics},
  file = {C\:\\Users\\iamga\\Zotero\\storage\\8PX6LH2F\\You et al. - 2026 - Characterization and active cancellation of power-line-induced motional-mode frequency noise in a tr.pdf;C\:\\Users\\iamga\\Zotero\\storage\\CVQKKEYF\\2602.html}
}

